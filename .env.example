# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=smartagenda

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRATION=7d

# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:4200

# Admin user (optional)
ADMIN_EMAIL=admin@smartagenda.com
ADMIN_PASSWORD=admin123

# Email/SMS (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@smartagenda.com

# Rate limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100
